# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/eduverse

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# GitHub API (optional but raises rate limit from 60/hr to 5000/hr)
# Create a token at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# Cloud AI (Google Gemini) - powers every AI feature in the app:
# Module 2 profile analysis (aiService.js), Module 3 placement analytics
# narrative (aiAnalyticsService.js), and the Module 4 AI Career Assistant
# chatbot (careerAssistantService.js). All three call through the single
# shared client in services/geminiClient.js.
#
# Get a free key at https://aistudio.google.com/apikey
# SECURITY: this key is read via process.env on the server only. It is
# never sent to the frontend, never included in any API response, and
# frontend code has no access to it — do not move it into frontend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin account (optional) - created/promoted on server start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Training & Placement Officer (TPO) account (optional) - created/promoted on
# server start. The TPO verifies recruiter drives and finalizes selections.
TPO_EMAIL=
TPO_PASSWORD=
TPO_NAME=Training & Placement Officer
